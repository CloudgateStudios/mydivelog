{
  "name": "mydivelog",
  "version": "0.0.0",
  "private": true,
  "description": "Digital dive logbook \u2014 https://mydivelog.app",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm services:up && turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "spellcheck": "cspell lint --no-progress --show-suggestions --relative",
    "spellcheck:words": "cspell lint --no-progress --relative --words-only --unique",
    "services:up": "docker compose up -d --wait postgres minio && docker compose up minio-init",
    "services:down": "docker compose down",
    "services:reset": "docker compose down -v && pnpm services:up",
    "db:migrate": "pnpm --filter @mydivelog/db db:migrate",
    "db:deploy": "pnpm --filter @mydivelog/db db:deploy",
    "db:seed": "pnpm --filter @mydivelog/db db:seed",
    "db:demo": "pnpm --filter @mydivelog/db db:demo",
    "openapi": "pnpm --filter @mydivelog/contracts openapi",
    "test:integration": "pnpm --filter @mydivelog/db test:integration && pnpm --filter @mydivelog/api test:integration",
    "db:reset": "pnpm --filter @mydivelog/db db:reset",
    "db:studio": "pnpm --filter @mydivelog/db db:studio",
    "verify": "turbo lint typecheck test build && pnpm format:check && pnpm spellcheck",
    "prepare": "husky",
    "demo": "node scripts/demo.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cspell": "^10.1.1",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.41.0"
  },
  "engines": {
    "node": ">=24"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
