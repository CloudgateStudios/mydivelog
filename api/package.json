{
  "name": "@mydivelog/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm prisma:generate && tsc -p tsconfig.build.json",
    "check": "pnpm prisma:validate && pnpm prisma:generate && pnpm typecheck",
    "dev": "tsx watch src/main.ts",
    "format": "prettier --check .",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "DATABASE_URL=postgresql://mydivelog:mydivelog@localhost:5432/mydivelog?schema=public prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:validate": "DATABASE_URL=postgresql://mydivelog:mydivelog@localhost:5432/mydivelog?schema=public prisma validate",
    "start": "node dist/main.js",
    "start:dev": "pnpm dev",
    "test": "node --test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "^6.14.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "prisma": "^6.14.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  }
}
