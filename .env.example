# Copy to .env for local development: `cp .env.example .env`
# Every value here is a local-only development credential. Real secrets live in
# Fly secrets, sourced from 1Password — never in this file.

NODE_ENV=development

# --- Ports -----------------------------------------------------------------
# Deliberately outside the crowded 3000-3003 block, which collides with almost
# every other local project. Change freely — nothing hardcodes these.
WEB_PORT=53000
API_PORT=53001
ADMIN_PORT=53002
WORKER_PORT=53003

# --- Database --------------------------------------------------------------
POSTGRES_PORT=55432
DATABASE_URL=postgresql://mydivelog:mydivelog@localhost:55432/mydivelog
# Deployed environments use a pooled connection for the app and a direct
# one for migrations. Locally there is no pooler, so both are the same.
DIRECT_DATABASE_URL=postgresql://mydivelog:mydivelog@localhost:55432/mydivelog

# --- Object storage (MinIO locally, Cloudflare R2 in deployed environments) --
MINIO_PORT=59000
MINIO_CONSOLE_PORT=59001
S3_ENDPOINT=http://localhost:59000
S3_REGION=auto
S3_ACCESS_KEY_ID=mydivelog
S3_SECRET_ACCESS_KEY=mydivelog-dev-secret
S3_BUCKET_UPLOADS=mydivelog-uploads
S3_BUCKET_PROFILES=mydivelog-profiles
S3_BUCKET_EXPORTS=mydivelog-exports
S3_FORCE_PATH_STYLE=true

# --- Service URLs ----------------------------------------------------------
API_URL=http://localhost:53001
WEB_URL=http://localhost:53000

# --- Auth -------------------------------------------------------------------
# Local development signs sessions with a throwaway secret and enables a stub
# login. Neither is permitted in a deployed environment: AuthConfig refuses to
# start without a real AUTH_ACCESS_SECRET unless dev login is explicitly on.
AUTH_DEV_LOGIN_ENABLED=true
AUTH_ACCESS_SECRET=local-development-secret-change-me-32-chars
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=60
AUTH_MAGIC_LINK_TTL_MINUTES=15

# Google OIDC. Absent, /auth/oauth/google/* answers "provider not configured"
# rather than failing obscurely.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:53001/v1/auth/oauth/google/callback

# Transactional email. Without it, magic links are written to the API log.
# RESEND_API_KEY=
# MAIL_FROM="MyDiveLog <no-reply@mydivelog.app>"

# Browsers treat the web and admin apps as cross-origin against the API.
CORS_ORIGINS=http://localhost:53000,http://localhost:53002

# --- Admin panel ------------------------------------------------------------
# The admin panel verifies the Cloudflare Access JWT itself, because Access
# protects a hostname and Fly serves every app on <app>.fly.dev as well —
# which reaches the same container without passing through Cloudflare.
#
# Locally there is no Access, so the check is turned off explicitly. It fails
# closed by default: an unconfigured check is indistinguishable from a missing
# one, and the cost of guessing wrong is publishing every diver's logbook.
ADMIN_ACCESS_CHECK_DISABLED=true

# Who staff changes are attributed to locally.
#
# The API verifies the same Access token independently of the panel — see
# apps/api/src/admin/staff.guard.ts — and with the check off there is no token
# to read an identity from. So the actor is named here, explicitly, rather than
# taken from a header: a development bypass that trusts a header is a
# production authentication bypass waiting for a misconfiguration.
#
# The address needs a row in `users` with `is_staff = true`. `pnpm demo`
# creates one; otherwise set the column by hand once.
ADMIN_DEV_STAFF_EMAIL=staff@mydivelog.local

# Set these on the deployed admin apps *and* on the API, which verifies the
# same token rather than trusting that the panel did. The team domain is the
# one in the Access login URL; the audience is the application's AUD tag, found
# under Access → Applications → Overview. Without the audience, a token minted
# for any other application in the same team is accepted here.
# CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# CF_ACCESS_AUD=...
